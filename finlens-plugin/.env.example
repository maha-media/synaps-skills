# ── finlens config ── copy to .env and fill what you want. Free path needs NOTHING.

# Watchlist (comma-separated). Default: NVDA,TSLA,AAPL,AMD,MSFT,META,AMZN,GOOGL
FINLENS_WATCHLIST=NVDA,TSLA,AAPL,AMD,PLTR,MSFT

# Output directory for reports + scratchpad logs
FINLENS_OUTPUT_DIR=output

# ── Data source (optional) ──
# financialdatasets.ai = paid primary (insider/fundamentals/news/prices in one clean API).
# Leave blank to run free-only (yfinance + SEC + StockTwits).
FINANCIALDATASETS_API_KEY=
FINLENS_USE_FD=1

# ── Synthesis LLM (optional) ──
# Without a key, Stage-2 produces a deterministic narrative. With one, an LLM explains the math.
FINLENS_LLM_PROVIDER=none          # none | anthropic | openai
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
FINLENS_LLM_MODEL=

# ── Synthesis tuning ──
FINLENS_MEFF_THRESHOLD=2.5
FINLENS_MAX_WORKERS=6

# ── Results API sink (cloud output channel) ──
# If set, finlens POSTs structured results JSON to this URL after each run.
# FINLENS_RESULTS_API=https://your-api.example.com/finlens/results
# FINLENS_RESULTS_API_TOKEN=               # optional → sent as "Authorization: Bearer <token>"
# FINLENS_RESULTS_API_METHOD=POST          # POST (default) or PUT
# FINLENS_RESULTS_API_REQUIRED=0           # 1 = fail the run if the POST fails
