#!/bin/sh
# jev-python: start Jev under a Python 3.11 or newer (macOS ships an older python3).
#
# Jev needs Python 3.11+ (tomllib in extensions/jev/roster.py). On a fresh Mac, python3
# is Apple's 3.9, and it exists only after the Command Line Tools are installed. Running
# /usr/bin/python3 without those tools pops an install dialog, so on macOS that python3
# is tried only when `xcode-select -p` says the tools are present: this launcher never
# prompts. A daemon started from Finder has the bare PATH /usr/bin:/bin:/usr/sbin:/sbin,
# and Synaps hands extensions only PATH/HOME/LANG/TERM/XDG_RUNTIME_DIR. So per-user
# installs (uv: `uv python install 3.13`, which links ~/.local/bin/python3.13 and keeps
# the interpreter under ~/.local/share/uv/python) and Homebrew's python3 are also tried
# by absolute path. A standard (non-admin) Mac user can't use Homebrew; uv needs no admin.
#
# Order: python3 on PATH (unchanged on Linux); $HOME/.local/bin/python3.14 ... 3.11 and
# python3; /opt/homebrew/bin/python3; /usr/local/bin/python3; python3.14 ... python3.11 on
# PATH; then uv's own cpython-3.1x installs. The first one that is 3.11+ runs Jev with the
# manifest's args (exec, same pid). If none fits, it says so on stderr and exits 127.
# Synaps then logs the extension as failed to start.

ok() {
    "$1" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1
}

try() {
    case $1 in
        /*) [ -x "$1" ] || return 1; p=$1 ;;
        *) p=$(command -v "$1" 2>/dev/null) || return 1 ;;
    esac
    if [ "$p" = /usr/bin/python3 ] && [ "$(uname -s 2>/dev/null)" = Darwin ] \
        && ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
        return 1
    fi
    ok "$p" || return 1
    py=$p
}

py=
h=${HOME:-/nonexistent}
for c in python3 \
    "$h/.local/bin/python3.14" "$h/.local/bin/python3.13" "$h/.local/bin/python3.12" \
    "$h/.local/bin/python3.11" "$h/.local/bin/python3" \
    /opt/homebrew/bin/python3 /usr/local/bin/python3 \
    python3.14 python3.13 python3.12 python3.11 \
    "$h"/.local/share/uv/python/cpython-3.1[1-9]*/bin/python3; do
    try "$c" && break
done

if [ -z "$py" ]; then
    echo "jev: needs Python 3.11 or newer and found none (tried python3 on PATH," \
        "~/.local/bin/python3.1x, /opt/homebrew/bin/python3, /usr/local/bin/python3," \
        "python3.14-3.11 on PATH, uv's cpython-3.1x). On a Mac: uv python install 3.13" \
        "(no admin needed). Jev's guard rules are OFF until then." >&2
    exit 127
fi

exec "$py" "$@"
